# =================================================================
# AeroSense-Exhaust Environment Configuration
# atomQUEST 2026 - Round 2
# =================================================================

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/live

# Backend Settings
PROJECT_NAME="AeroSense-Exhaust SCADA Backend"
VERSION=2.4.1
API_V1_STR=/api/v1

# SQLite local database (switchable to Postgres: postgresql://user:pass@localhost:5432/aerosense)
DATABASE_URL=sqlite:///./aerosense.db

# MQTT Broker (Public demonstration broker or local Mosquitto)
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=aerosense/device/telemetry
MQTT_TOPIC_COMMAND=aerosense/device/command

# ESP32 Default Identity
DEVICE_ID=AEROSENSE_ESP32_01

